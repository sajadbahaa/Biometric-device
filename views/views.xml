        <!--   create inherit Employee list new -->
        <record model="ir.ui.view" id="inherit_emp_form">

            <field name="name">inherit emp form</field>
            <field name="model">inherit_emp</field>
            <field name="arch" type="xml">
                <form>
<!--<header>-->
<!--    <field name="employee_id" readonly="1"/>-->
<!--</header>-->
                    <sheet>
                        <group>
                            <group>
                                <group colspan="3">

                                    <field name="employee_id" readonly="1"/>
                                    <field name="finger_print_id" string="Finger Print ID"/>

                                    <p colspan="4">Finger Print :
                                        <button name="Finger_Print" string="Finger Enroll" type="object"/>
                                        <button name="delete_finger_data" string="Delete Finger Data" type="object"/>
                                    </p>
                                    <p colspan="4">Face Data :
                                        <button name="Face_Data" string="Face Enroll" type="object"/>
                                        <button name="delete_face_data" string="Delete Face Data" type="object"/>
                                    </p>
                                </group>


                                <!--                                <field name="finger_data" string="finger data"/>-->
                                <!--                                <field name="face_data" string="face data"/>-->

                                <group>
                                    <field name="card_id" string="Card ID"/>
                                    <field name="password" string="Password"/>
                                    <field name="device_id" string="Enroll device"/>
                                </group>
                            </group>

                            <group>
                                <field name="image" widget="image" style="width:100px;height:auto"/>
                            </group>
                            <hr style="width: 100%; border: 1px solid ; margin-top: 10px; margin-bottom: 10px;"/>

                            <!--                            <group>-->
                            <!--                                <p colspan="4">Select Other Device : <field name="many_devices" domain="[('device_status', '=', False)]" widget="many2many_tags"/></p>-->
                            <!--                            </group>-->

                            <group colspan="2">
                                <field name="many_devices" domain="[('device_status', '=', False)]" string="Devices"/>
                            </group>
                            <group >
                            <group >
                                <div style="display: flex; gap: 40px;white-space: nowrap;">

                                    <button name="device_add_finger" string="Add Finger" type="object"/>
                                    <button name="device_add_face" string="Add Face" type="object"/>
                                    <button name="device_add_card" string="Add Card" type="object"/>
                                    <button name="device_add_password" string="Add Password" type="object"/>
                                    <button name="delete_emp_from_device" string="Delete Employee from Devices" type="object"/>
                                </div>
                            </group>

                            </group>

                        </group>
                    </sheet>

                </form>
            </field>
        </record>


        <!-- Employee list tree  -->
        <record model="ir.ui.view" id="inherit_emp_list">
            <field name="name">inherit_emp list</field>
            <field name="model">inherit_emp</field>

            <field name="arch" type="xml">
                <tree>
                    <field name="employee_id" readonly="1"/>
                    <field name="finger_print_id" optional="hide" readonly="1"/>
                    <field name="is_register" readonly="1"/>
                </tree>
            </field>
        </record>



        <record model="ir.actions.act_window" id="inherit_emp_id_action_window">
            <field name="name">Employees</field>
            <field name="res_model">inherit_emp</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- Employee list   -->


        <record model="ir.actions.act_window" id="configuration_device_id_action">
            <field name="name">device config</field>
            <field name="res_model">config_device</field>
            <field name="view_mode">tree,form</field>
        </record>


        <!-- Top menu item -->

        <menuitem name="Biometric Device Manager" id="ai_Finger_Print_module.menu_root" sequence="1"/>


        <!-- menu categories -->

        <menuitem name="Employee List" id="ai_Finger_Print_module.home_page" parent="ai_Finger_Print_module.menu_root"
                  action="inherit_emp_id_action_window" sequence="2"/>

        <menuitem name="manager" id="ai_Finger_Print_module.manager" parent="ai_Finger_Print_module.menu_root"
                  sequence="3"/>


        <!-- actions -->

        <menuitem name="Device configuration" id="ai_Finger_Print_module.configration"
                  parent="ai_Finger_Print_module.manager"
                  action="configuration_device_id_action"/>
        <menuitem name="Attendance log" id="ai_Finger_Print_module.attendance_log" parent="ai_Finger_Print_module.manager"
                  action="attendance_log_id_action_window"/>
    </data>
</odoo>


